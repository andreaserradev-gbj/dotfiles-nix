// niri greeter compositor: the niri instance that hosts regreet at the
// greetd login (hosts/geekom/greeter.nix delivers this file to
// /etc/niri/greeter.kdl). Minimal on purpose — the greeter shows one login
// field, so only what the login screen itself needs is declared here. The
// user session runs config/niri/config.kdl; no Noctalia, no spawn rules.

// Same 4K panel and scale as the user session, so the handoff does not
// rescale the display.
output "DP-6" {
  scale 1.25
}

hotkey-overlay {
  // The startup popup is noise on a login screen.
  skip-at-startup
}

input {
  keyboard {
    // Empty xkb block on purpose: niri reads the layout from systemd-localed,
    // which modules/nixos/desktop.nix sets from user.keyboardLayout — the
    // greeter must type passwords on the same layout the session uses.
    numlock
  }
}

binds {
  // Focus basics only: regreet draws one window. Column machinery,
  // workspaces and spawns belong to the user session's config.
  Mod+Left { focus-column-left; }
  Mod+H { focus-column-left; }
  Mod+Right { focus-column-right; }
  Mod+L { focus-column-right; }

  // Escape hatch: quit the greeter compositor; greetd restarts it.
  Mod+Shift+E { quit; }
}
