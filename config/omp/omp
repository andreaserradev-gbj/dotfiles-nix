#!/usr/bin/env bash
# herdr panes spawn from the herdr server's frozen boot environment (the server
# is a user unit on default.target, before niri-session imports anything), so
# the first omp of a restored pane inherits no session variables and every
# clipboard tool inside it fails. The shell-level repair (modules/home/shell.nix)
# retries from precmd, but precmd never runs while omp occupies the pane's
# foreground — and the resume herdr types into that pane is exactly the first
# thing that blocks it. So omp repairs at spawn instead: same variable set,
# same source as the shell hook. No-op outside herdr and on headless boots,
# where the user manager has nothing to import.
if [[ $HERDR_ENV == 1 && -z $WAYLAND_DISPLAY ]]; then
  while IFS= read -r line; do
    export "$line"
  done < <(systemctl --user show-environment 2>/dev/null |
    grep -E '^(WAYLAND_DISPLAY|DISPLAY|NIRI_SOCKET|XDG_SESSION_TYPE|XDG_CURRENT_DESKTOP)=')
fi

exec "$(dirname "$(readlink -f "$0")")/omp-unwrapped" "$@"
