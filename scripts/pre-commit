#!/usr/bin/env bash
# pre-commit hook — reject a commit whose staged .nix files are not nixfmt-clean.
#
# Self-installed into git's hooks directory by .envrc on every reload, from this
# tracked canonical copy. It runs `nixfmt` from the devShell PATH (pinned by
# flake.lock), never writes or stages anything, and never inspects a file that is
# not already staged — only what is about to be committed.
set -euo pipefail

# First, before any other command: the environment missing `nixfmt` is the same
# one whose /usr/bin/env bash is macOS's bash 3.2, where the `mapfile` below does
# not exist. The real cause is an unloaded devShell, and its message must win.
if ! command -v nixfmt >/dev/null 2>&1; then
  echo "!! pre-commit: nixfmt not on PATH." >&2
  echo "   Run 'direnv allow' (or 'nix develop') to load the devShell." >&2
  exit 1
fi

# `--diff-filter=d` drops deleted entries, so the list names files that exist.
mapfile -t files < <(
  git diff --cached --name-only --diff-filter=d -- '*.nix'
)

if [ "${#files[@]}" -eq 0 ]; then
  exit 0
fi

# `--check` reports instead of rewriting, naming each offending file itself. It
# exits non-zero for an unformatted file and for a parse error alike, and aborting
# is right in both cases: the first would fail CI's `nix fmt -- --ci`, and a
# syntactically broken .nix should not land even if the author forced it through.
if ! nixfmt --check -- "${files[@]}"; then
  echo "!! pre-commit: the staged .nix files above are not nixfmt-clean." >&2
  echo "   Run 'nix fmt' and stage the result." >&2
  exit 1
fi

echo "pre-commit: ${#files[@]} staged .nix file(s) are nixfmt-clean"
