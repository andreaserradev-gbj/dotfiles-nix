# direnv entry for this repo. Loads the flake's devShell (which carries
# nixfmt/statix/nil/deadnix) and self-installs the tracked pre-commit hook into
# the hooks directory git actually reads, on every direnv reload. The
# comparison is idempotent: a hook that already matches the tracked copy is not
# rewritten, so there is no churn and no hook re-trigger.
#
# The hook itself is version-controlled at scripts/pre-commit so the canonical
# copy ships with the repo; this entry only mirrors it into the hooks dir (which
# is not tracked by git). The hook runs `nixfmt` resolved by THIS devShell's
# PATH, so formatting stays pinned via flake.lock.
if has nix; then
  use flake
fi

# Self-install the tracked pre-commit hook. `git rev-parse --git-path` asks git
# where it would look for that hook, which is what keeps this correct in a
# linked worktree: `--git-dir` names the worktree's own admin dir
# (.git/worktrees/<name>) and git does not read hooks from there — it reads
# them from the common dir, so a hook installed there would never run.
#
# `-C` pins the answer to the repo root: `--git-path` returns a path relative
# to wherever it ran — `.git/hooks/…` at the top level, `../.git/hooks/…` from a
# subdirectory, an absolute path for a worktree — and the relative forms are
# anchored below rather than left to the caller's cwd.
repo_root="$(git rev-parse --show-toplevel 2>/dev/null)" || return
installed_hook="$(git -C "$repo_root" rev-parse --git-path hooks/pre-commit 2>/dev/null)" || return
case "$installed_hook" in
  /*) ;;
  *) installed_hook="$repo_root/$installed_hook" ;;
esac
tracked_hook="$repo_root/scripts/pre-commit"
if [ -f "$tracked_hook" ]; then
  if ! [ -f "$installed_hook" ] || ! cmp -s "$tracked_hook" "$installed_hook"; then
    install -m0755 "$tracked_hook" "$installed_hook"
  fi
fi
unset repo_root tracked_hook installed_hook
