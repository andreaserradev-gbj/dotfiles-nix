# direnv entry: loads the flake's devShell (nixfmt/statix/nil/deadnix) and
# self-installs the tracked hook from scripts/pre-commit into the directory git
# actually reads, on every reload. Idempotent — a hook that already matches the
# tracked copy is not rewritten. The hook runs `nixfmt` from THIS devShell, so
# formatting stays pinned via flake.lock.
if has nix; then
  use flake
fi

# `git rev-parse --git-path hooks/pre-commit` asks git where it WOULD look for
# that hook, which is what keeps this correct in a linked worktree: `--git-dir`
# names the worktree's own admin dir (.git/worktrees/<name>), and git does not
# read hooks from there — it reads them from the common dir, so a hook installed
# there would never run.
#
# `-C` pins the answer to the repo root: `--git-path` returns a path relative to
# wherever it ran — `.git/hooks/…` at the top level, `../.git/hooks/…` from a
# subdirectory, an absolute path for a worktree — and the relative forms are
# anchored below rather than left to the caller's cwd.
repo_root="$(git rev-parse --show-toplevel 2>/dev/null)" || return
installed_hook="$(git -C "$repo_root" rev-parse --git-path hooks/pre-commit 2>/dev/null)" || return
case "$installed_hook" in
  /*) ;;
  *) installed_hook="$repo_root/$installed_hook" ;;
esac
tracked_hook="$repo_root/scripts/pre-commit"
if [ -f "$tracked_hook" ]; then
  if ! [ -f "$installed_hook" ] || ! cmp -s "$tracked_hook" "$installed_hook"; then
    install -m0755 "$tracked_hook" "$installed_hook"
  fi
fi
unset repo_root tracked_hook installed_hook
