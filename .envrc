# direnv entry for this repo. Loads the flake's devShell (which carries
# nixfmt/statix/nil/deadnix) and self-installs the tracked pre-commit hook
# into .git/hooks/pre-commit on every direnv reload. The comparison is
# idempotent: a hook that already matches the tracked copy is not rewritten,
# so there is no churn and no hook re-trigger.
#
# The hook itself is version-controlled at scripts/pre-commit so the canonical
# copy ships with the repo; this entry only mirrors it into the per-clone
# .git/hooks dir (which is not tracked by git). The hook runs `nixfmt`
# resolved by THIS devShell's PATH, so formatting stays pinned via flake.lock.
if has nix; then
  use flake
fi

# Self-install the tracked pre-commit hook. `git rev-parse --git-dir` resolves
# to .git for a plain repo or the worktree's git dir for a worktree, and is
# robust to bare clones and linked worktrees alike.
git_dir="$(git rev-parse --git-dir 2>/dev/null)" || return
repo_root="$(git rev-parse --show-toplevel 2>/dev/null)" || return
tracked_hook="$repo_root/scripts/pre-commit"
installed_hook="$git_dir/hooks/pre-commit"
if [ -f "$tracked_hook" ]; then
  if ! [ -f "$installed_hook" ] || ! cmp -s "$tracked_hook" "$installed_hook"; then
    install -m0755 "$tracked_hook" "$installed_hook"
  fi
fi
unset git_dir repo_root tracked_hook installed_hook